<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gestione Ordini Personale</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    body { background-color: #f8fafc; font-family: system-ui, -apple-system, sans-serif; }
  </style>
</head>
<body class="p-4 md:p-8 max-w-6xl mx-auto text-slate-800">

  <!-- Header & Statistiche -->
  <header class="mb-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-900 flex items-center gap-2">
        <i data-lucide="shopping-bag" class="text-indigo-600"></i> Gestore Ordini
      </h1>
      <p class="text-slate-500 text-sm">Organizza e traccia i tuoi lavori e personalizzazioni</p>
    </div>
    <div class="flex gap-2">
      <button onclick="exportData()" class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm rounded-lg flex items-center gap-1">
        <i data-lucide="download" class="w-4 h-4"></i> Backup Dati
      </button>
      <label class="px-3 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 text-sm rounded-lg flex items-center gap-1 cursor-pointer">
        <i data-lucide="upload" class="w-4 h-4"></i> Ripristina
        <input type="file" id="importFile" accept=".json" class="hidden" onchange="importData(event)">
      </label>
      <button onclick="openModal()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg font-medium flex items-center gap-2 shadow-sm">
        <i data-lucide="plus"></i> Nuovo Ordine
      </button>
    </div>
  </header>

  <!-- Metric Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Ordini Attivi</p>
        <h2 id="statActive" class="text-2xl font-bold text-slate-800">0</h2>
      </div>
      <div class="p-3 bg-amber-50 text-amber-600 rounded-lg"><i data-lucide="clock"></i></div>
    </div>
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Da Incassare</p>
        <h2 id="statPending" class="text-2xl font-bold text-rose-600">€ 0.00</h2>
      </div>
      <div class="p-3 bg-rose-50 text-rose-600 rounded-lg"><i data-lucide="circle-dollar-sign"></i></div>
    </div>
    <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Totale Incassato</p>
        <h2 id="statEarned" class="text-2xl font-bold text-emerald-600">€ 0.00</h2>
      </div>
      <div class="p-3 bg-emerald-50 text-emerald-600 rounded-lg"><i data-lucide="wallet"></i></div>
    </div>
  </div>

  <!-- Controlli di Filtro -->
  <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-200 mb-6 flex flex-col md:flex-row gap-4">
    <div class="relative flex-1">
      <i data-lucide="search" class="absolute left-3 top-3 w-4 h-4 text-slate-400"></i>
      <input type="text" id="searchInput" placeholder="Cerca cliente o articolo..." oninput="renderOrders()" class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500">
    </div>
    <div class="flex gap-2 overflow-x-auto pb-1 md:pb-0">
      <button onclick="setFilter('all')" id="filter-all" class="px-3 py-2 rounded-lg text-sm font-medium bg-indigo-100 text-indigo-700">Tutti</button>
      <button onclick="setFilter('Da iniziare')" id="filter-Da iniziare" class="px-3 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600">Da iniziare</button>
      <button onclick="setFilter('In lavorazione')" id="filter-In lavorazione" class="px-3 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600">In lavorazione</button>
      <button onclick="setFilter('Pronto')" id="filter-Pronto" class="px-3 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600">Pronto</button>
      <button onclick="setFilter('Consegnato')" id="filter-Consegnato" class="px-3 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600">Consegnato</button>
    </div>
  </div>

  <!-- Griglia Ordini -->
  <div id="ordersGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4"></div>

  <!-- Modal Inserimento/Modifica -->
  <div id="orderModal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-xl max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center mb-4">
        <h3 id="modalTitle" class="text-xl font-bold text-slate-900">Nuovo Ordine</h3>
        <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600"><i data-lucide="x"></i></button>
      </div>

      <form id="orderForm" onsubmit="saveOrder(event)" class="space-y-4">
        <input type="hidden" id="orderId">
        
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Nome Cliente *</label>
          <input type="text" id="clientName" required class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Telefono / WhatsApp</label>
          <input type="text" id="clientPhone" placeholder="+39 333..." class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Articolo / Commessa *</label>
          <input type="text" id="itemTitle" required placeholder="es. Telo mare ricamato" class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Dettagli & Personalizzazione</label>
          <textarea id="itemDetails" rows="3" placeholder="es. Nome 'Sofia', font corsivo, filo rosa cipria..." class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Prezzo Totale (€) *</label>
            <input type="number" step="0.01" id="totalPrice" required oninput="calcBalance()" class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Acconto (€)</label>
            <input type="number" step="0.01" id="deposit" value="0" oninput="calcBalance()" class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div class="bg-slate-50 p-3 rounded-lg border border-slate-200 flex justify-between items-center text-sm">
          <span class="font-medium text-slate-600">Saldo Rimanente:</span>
          <span id="balanceDisplay" class="font-bold text-slate-900">€ 0.00</span>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Stato Ordine</label>
            <select id="orderStatus" class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
              <option value="Da iniziare">Da iniziare</option>
              <option value="In lavorazione">In lavorazione</option>
              <option value="Pronto">Pronto</option>
              <option value="Consegnato">Consegnato</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-600 mb-1">Data Consegna</label>
            <input type="date" id="dueDate" class="w-full p-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
          </div>
        </div>

        <div class="pt-4 flex justify-end gap-2">
          <button type="button" onclick="closeModal()" class="px-4 py-2 border border-slate-300 text-slate-600 rounded-lg text-sm hover:bg-slate-50">Annulla</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg text-sm hover:bg-indigo-700 font-medium">Salva Ordine</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    let orders = JSON.parse(localStorage.getItem('my_orders_data')) || [];
    let currentFilter = 'all';

    function saveToStorage() {
      localStorage.setItem('my_orders_data', JSON.stringify(orders));
      renderOrders();
      updateStats();
    }

    function calcBalance() {
      const price = parseFloat(document.getElementById('totalPrice').value) || 0;
      const deposit = parseFloat(document.getElementById('deposit').value) || 0;
      const balance = Math.max(0, price - deposit);
      document.getElementById('balanceDisplay').innerText = `€ ${balance.toFixed(2)}`;
    }

    function openModal(id = null) {
      document.getElementById('orderForm').reset();
      document.getElementById('orderId').value = '';
      document.getElementById('balanceDisplay').innerText = '€ 0.00';
      document.getElementById('modalTitle').innerText = id ? 'Modifica Ordine' : 'Nuovo Ordine';

      if (id) {
        const item = orders.find(o => o.id === id);
        if (item) {
          document.getElementById('orderId').value = item.id;
          document.getElementById('clientName').value = item.clientName;
          document.getElementById('clientPhone').value = item.clientPhone || '';
          document.getElementById('itemTitle').value = item.itemTitle;
          document.getElementById('itemDetails').value = item.itemDetails || '';
          document.getElementById('totalPrice').value = item.totalPrice;
          document.getElementById('deposit').value = item.deposit || 0;
          document.getElementById('orderStatus').value = item.status;
          document.getElementById('dueDate').value = item.dueDate || '';
          calcBalance();
        }
      }
      document.getElementById('orderModal').classList.remove('hidden');
      document.getElementById('orderModal').classList.add('flex');
    }

    function closeModal() {
      document.getElementById('orderModal').classList.add('hidden');
      document.getElementById('orderModal').classList.remove('flex');
    }

    function saveOrder(e) {
      e.preventDefault();
      const id = document.getElementById('orderId').value || Date.now().toString();
      const newOrder = {
        id,
        clientName: document.getElementById('clientName').value,
        clientPhone: document.getElementById('clientPhone').value,
        itemTitle: document.getElementById('itemTitle').value,
        itemDetails: document.getElementById('itemDetails').value,
        totalPrice: parseFloat(document.getElementById('totalPrice').value) || 0,
        deposit: parseFloat(document.getElementById('deposit').value) || 0,
        status: document.getElementById('orderStatus').value,
        dueDate: document.getElementById('dueDate').value,
        createdAt: new Date().toISOString()
      };

      const existingIndex = orders.findIndex(o => o.id === id);
      if (existingIndex > -1) {
        orders[existingIndex] = newOrder;
      } else {
        orders.unshift(newOrder);
      }

      saveToStorage();
      closeModal();
    }

    function deleteOrder(id) {
      if (confirm('Sei sicura di voler eliminare questo ordine?')) {
        orders = orders.filter(o => o.id !== id);
        saveToStorage();
      }
    }

    function setFilter(filter) {
      currentFilter = filter;
      document.querySelectorAll('[id^="filter-"]').forEach(btn => {
        btn.className = 'px-3 py-2 rounded-lg text-sm font-medium bg-slate-100 text-slate-600';
      });
      document.getElementById(`filter-${filter}`).className = 'px-3 py-2 rounded-lg text-sm font-medium bg-indigo-100 text-indigo-700';
      renderOrders();
    }

    function sendWhatsApp(id) {
      const o = orders.find(item => item.id === id);
      if (!o) return;
      const balance = (o.totalPrice - o.deposit).toFixed(2);
      let msg = `Ciao ${o.clientName}! 👋🏼%0A%0AEcco il riepilogo del tuo ordine:%0A📌 *Articolo:* ${o.itemTitle}%0A📝 *Dettagli:* ${o.itemDetails || 'N/D'}%0A%0A💰 *Totale:* €${o.totalPrice.toFixed(2)}%0A💳 *Acconto:* €${o.deposit.toFixed(2)}%0A🏷️ *Saldo rimanente:* €${balance}%0A%0AStato attuale: *${o.status}*`;
      
      const phone = o.clientPhone ? o.clientPhone.replace(/[^0-9]/g, '') : '';
      const url = phone ? `https://wa.me/${phone}?text=${msg}` : `https://wa.me/?text=${msg}`;
      window.open(url, '_blank');
    }

    function renderOrders() {
      const container = document.getElementById('ordersGrid');
      const search = document.getElementById('searchInput').value.toLowerCase();
      container.innerHTML = '';

      const filtered = orders.filter(o => {
        const matchesFilter = currentFilter === 'all' || o.status === currentFilter;
        const matchesSearch = o.clientName.toLowerCase().includes(search) || o.itemTitle.toLowerCase().includes(search);
        return matchesFilter && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-slate-400">Nessun ordine trovato.</div>`;
        return;
      }

      const statusColors = {
        'Da iniziare': 'bg-slate-100 text-slate-700',
        'In lavorazione': 'bg-amber-100 text-amber-800',
        'Pronto': 'bg-blue-100 text-blue-800',
        'Consegnato': 'bg-emerald-100 text-emerald-800'
      };

      filtered.forEach(o => {
        const balance = o.totalPrice - o.deposit;
        const card = document.createElement('div');
        card.className = 'bg-white rounded-xl p-5 shadow-sm border border-slate-200 flex flex-col justify-between space-y-4';
        card.innerHTML = `
          <div>
            <div class="flex justify-between items-start mb-2">
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full ${statusColors[o.status] || 'bg-slate-100'}">${o.status}</span>
              ${o.dueDate ? `<span class="text-xs text-slate-500 flex items-center gap-1"><i data-lucide="calendar" class="w-3 h-3"></i> ${o.dueDate}</span>` : ''}
            </div>
            <h4 class="font-bold text-slate-900 text-lg">${o.itemTitle}</h4>
            <p class="text-sm font-medium text-slate-600 mb-2">👤 ${o.clientName}</p>
            ${o.itemDetails ? `<p class="text-xs text-slate-500 bg-slate-50 p-2 rounded-lg border border-slate-100 whitespace-pre-line">${o.itemDetails}</p>` : ''}
          </div>

          <div class="border-t border-slate-100 pt-3">
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>Totale: €${o.totalPrice.toFixed(2)}</span>
              <span>Acconto: €${o.deposit.toFixed(2)}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-bold ${balance > 0 ? 'text-rose-600' : 'text-emerald-600'}">
                ${balance > 0 ? `Saldo: €${balance.toFixed(2)}` : 'Saldato'}
              </span>
              <div class="flex gap-1">
                <button onclick="sendWhatsApp('${o.id}')" title="Invia su WhatsApp" class="p-2 text-emerald-600 hover:bg-emerald-50 rounded-lg"><i data-lucide="message-circle" class="w-4 h-4"></i></button>
                <button onclick="openModal('${o.id}')" title="Modifica" class="p-2 text-indigo-600 hover:bg-indigo-50 rounded-lg"><i data-lucide="pencil" class="w-4 h-4"></i></button>
                <button onclick="deleteOrder('${o.id}')" title="Elimina" class="p-2 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg"><i data-lucide="trash-2" class="w-4 h-4"></i></button>
              </div>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
      lucide.createIcons();
    }

    function updateStats() {
      const active = orders.filter(o => o.status !== 'Consegnato').length;
      const pending = orders.reduce((acc, o) => acc + Math.max(0, o.totalPrice - o.deposit), 0);
      const earned = orders.reduce((acc, o) => acc + (o.deposit + (o.status === 'Consegnato' ? Math.max(0, o.totalPrice - o.deposit) : 0)), 0);

      document.getElementById('statActive').innerText = active;
      document.getElementById('statPending').innerText = `€ ${pending.toFixed(2)}`;
      document.getElementById('statEarned').innerText = `€ ${earned.toFixed(2)}`;
    }

    function exportData() {
      const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(orders));
      const downloadAnchor = document.createElement('a');
      downloadAnchor.setAttribute("href", dataStr);
      downloadAnchor.setAttribute("download", `backup_ordini_${new Date().toISOString().slice(0,10)}.json`);
      document.body.appendChild(downloadAnchor);
      downloadAnchor.click();
      downloadAnchor.remove();
    }

    function importData(event) {
      const fileReader = new FileReader();
      fileReader.onload = function(e) {
        try {
          const imported = JSON.parse(e.target.result);
          if (Array.isArray(imported)) {
            orders = imported;
            saveToStorage();
            alert('Dati ripristinati con successo!');
          }
        } catch(err) {
          alert('File non valido.');
        }
      };
      fileReader.readAsText(event.target.files[0]);
    }

    // Inizializzazione
    renderOrders();
    updateStats();
    lucide.createIcons();
  </script>
</body>
</html>
